# Copy to .env and fill in. .env is gitignored; this template is committed.

# --- LLM: any OpenAI-compatible endpoint ---------------------------------------
# Groq is the default (free key at https://console.groq.com).
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=1500
# Fully self-hosted instead (a chat model served by Ollama on the droplet):
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen3:8b

# --- Embeddings (Ollama) and vector database (Qdrant) ---------------------------
EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_URL=http://127.0.0.1:11434
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=qabuddy

# --- Data ----------------------------------------------------------------------
# The folder that holds 00_TestCases ... 08_Source_Codes (relative to this file).
QABUDDY_DATA_DIR=../data

# --- Retrieval and token budget -------------------------------------------------
TOP_K=8
RETRIEVAL_CANDIDATES=30
CONTEXT_TOKENS=4000
# Optional reranking of the hybrid results: none | cohere
RERANKER=none
COHERE_API_KEY=

# --- Jira over MCP --------------------------------------------------------------
# Credentials for the MCP server (mcp-atlassian reads these).
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
# The query that selects the tickets to index.
JIRA_JQL=
# Connect to a running MCP server over Streamable HTTP ...
JIRA_MCP_URL=
JIRA_MCP_TOKEN=
# ... or launch one over stdio, for example: JIRA_MCP_COMMAND=uvx  JIRA_MCP_ARGS=mcp-atlassian
JIRA_MCP_COMMAND=
JIRA_MCP_ARGS=
JIRA_MCP_SEARCH_TOOL=jira_search

# --- Web app --------------------------------------------------------------------
QABUDDY_HOST=127.0.0.1
QABUDDY_PORT=8000
# Set both to require a login (HTTP Basic). Always set them on a public server.
QABUDDY_USERNAME=
QABUDDY_PASSWORD=
